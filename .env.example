# Copy to .env and adjust. Local dev only — never commit real secrets.

DATABASE_URL=postgres://thriski:thriski@localhost:5432/thriski

# Sumsub (ID&V provider — OQ-16 resolved). Get sandbox keys from the Sumsub dashboard.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com

# Auth (Epic 2). Dev-only fallbacks exist in src/config/env.ts if these are left blank —
# always set real values before anything but a laptop.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
MFA_ENCRYPTION_KEY=

# Email (AUTH-005 password reset). Leave EMAIL_PROVIDER=console to log emails instead
# of sending them — no external account needed for local dev.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@thriski.local

PORT=3000
