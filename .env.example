# Copy to .env and adjust. Local dev only — never commit real secrets.

DATABASE_URL=postgres://thriski:thriski@localhost:5432/thriski

# Sumsub (ID&V provider — OQ-16 resolved). Get sandbox keys from the Sumsub dashboard.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
# The verification level name configured for individual KYC in YOUR Sumsub dashboard —
# this is account-specific, not a fixed string. Leave blank to fall back to a guess
# that is almost certainly wrong for a real account.
SUMSUB_KYC_LEVEL_NAME=
# Only set this if your dashboard's webhook subscription uses a secret different from
# SUMSUB_SECRET_KEY above — otherwise leave blank and it reuses that value.
SUMSUB_WEBHOOK_SECRET=
# Whichever digest algorithm your webhook subscription is configured with in the
# Sumsub dashboard — 'sha256' or 'sha1'.
SUMSUB_WEBHOOK_DIGEST_ALG=sha256

# Auth (Epic 2). Dev-only fallbacks exist in src/config/env.ts if these are left blank —
# always set real values before anything but a laptop.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
MFA_ENCRYPTION_KEY=

# Email (AUTH-005 password reset). Leave EMAIL_PROVIDER=console to log emails instead
# of sending them — no external account needed for local dev.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@thriski.local

# ABN Lookup (ONB-014/BUS-024 — Section 6.1a). Free self-registered GUID from
# https://abr.business.gov.au/Tools/WebServices — leave blank to run without it; the
# lookup endpoint returns "not configured" and manual entry still works.
ABR_ABN_LOOKUP_GUID=

PORT=3000
