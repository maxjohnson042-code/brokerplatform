{
  "name": "thriski",
  "version": "0.1.0",
  "private": true,
  "description": "Broker onboarding, accreditation and ongoing monitoring platform. Modular monolith per Master Requirements and Architecture Document v2.0, Section 19.",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "ts-node db/migrate.ts up",
    "migrate:down": "ts-node db/migrate.ts down",
    "demo:tenancy": "ts-node scripts/demo-tenancy.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest",
    "lint:architecture": "jest test/architecture.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "dotenv": "^17.4.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "fast-glob": "^3.3.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
