{
  "name": "brok3r",
  "version": "0.1.0",
  "private": true,
  "description": "Broker onboarding, accreditation and ongoing monitoring platform. Modular monolith per Master Requirements and Architecture Document v2.0, Section 19.",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "ts-node db/migrate.ts up",
    "migrate:down": "ts-node db/migrate.ts down",
    "demo:tenancy": "ts-node scripts/demo-tenancy.ts",
    "seed:platform-admin": "ts-node scripts/seed-platform-admin.ts",
    "seed:rulesets": "ts-node scripts/seed-rulesets.ts",
    "seed:demo-data": "ts-node scripts/seed-demo-data.ts",
    "purge:demo-data": "ts-node scripts/purge-demo-data.ts",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest",
    "lint:architecture": "jest test/architecture.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "fast-glob": "^3.3.2",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
